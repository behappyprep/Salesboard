# Shopify app configuration example; do not commit real credentials.
client_id = "REPLACE_WITH_SHOPIFY_CLIENT_ID"
name = "ChannelPilot"
application_url = "https://channelpilot-web.onrender.com"
embedded = false

[access_scopes]
scopes = "read_orders,read_products,read_inventory"

[auth]
redirect_urls = ["https://channelpilot-web.onrender.com/api/oauth/shopify/callback"]

[webhooks]
api_version = "2026-07"

[[webhooks.subscriptions]]
compliance_topics = ["customers/data_request", "customers/redact", "shop/redact"]
uri = "/api/webhooks/shopify"

[[webhooks.subscriptions]]
topics = ["app/uninstalled"]
uri = "/api/webhooks/shopify"
